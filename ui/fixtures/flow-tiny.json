            " * The admin app's better-auth instance: jwt() signs the access tokens and mcp() makes it the",
            " * OAuth 2.1 server for the MCP endpoint. apps/admin-api only verifies what is minted here;",
            " * it never signs anything itself.",
            " */"
          ],
          "kind": "comment",
          "score": 0.98
        },
        {
          "path": "packages/auth/src/auth-admin.ts",
          "line": 16,
          "lines": [
            "export const adminAuth = betterAuth({",
            "  ...baseAuthOptions({ appName: \"Acme Admin\", baseURL: adminUrls.api }),",
            "  plugins: [",
            "    admin(),",
            "    bearer(),",
            "    jwt({ jwt: { issuer: adminUrls.issuer, audience: adminUrls.mcpResource, expirationTime: \"15m\" } }),",
            "    mcp({ loginPage: adminUrls.loginPage, consentPage: adminUrls.consentPage }),"
          ],
          "kind": "code",
          "score": 0.97
        }
