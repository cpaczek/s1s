          "lines": [
            "/**",
            " * Verifies the bearer JWT against the issuer's JWKS, then re-checks that the OAuth grant still",
            " * stands. The tokens are minted by the jwt() plugin configured in packages/auth/src/auth-admin.ts;",
            " * nothing in this app can sign one.",
            " */"
          ],
          "kind": "comment",
          "score": 0.97
        },
        {
          "path": "apps/admin-api/src/mcp/verifier.ts",
          "line": 14,
          "lines": [
            "const jwks = createRemoteJWKSet(new URL(adminUrls.jwks));",
            "",
            "export const mcpBearerAuth: MiddlewareHandler<AppEnv> = async (c, next) => {",
            "  const token = readBearerToken(c.req.header(\"authorization\"));",
            "  if (!token) return challenge(c, \"missing_token\");",
            "  const { payload } = await jwtVerify(token, jwks, { issuer: adminUrls.issuer, audience: adminUrls.mcpResource });"
          ],
          "kind": "code",
          "score": 0.98
        }
      ]
    },
